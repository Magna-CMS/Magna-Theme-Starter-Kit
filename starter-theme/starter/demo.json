                                    "id": "starter-blk-4",
                                    "block": "features",
                                    "settings": {},
                                    "data": {
                                        "layout": "icon-grid",
                                        "items": "[{\"icon\": \"⚡\", \"title\": \"Fast by default\", \"description\": \"One inline stylesheet, no build step and no web fonts to wait for.\"}, {\"icon\": \"◐\", \"title\": \"Light and dark\", \"description\": \"Every colour token ships a dark value. Visitors pick, the page stays cacheable.\"}, {\"icon\": \"✎\", \"title\": \"Editable everywhere\", \"description\": \"Retune colours, fonts and widths in the builder's Design panel, without touching a file.\"}, {\"icon\": \"♿\", \"title\": \"Accessible\", \"description\": \"A skip link, visible focus, real buttons and colours that pass contrast checks.\"}, {\"icon\": \"⌘\", \"title\": \"Every core block\", \"description\": \"Heroes, pricing, FAQs, tables, code and more — all styled from the same tokens.\"}, {\"icon\": \"⧉\", \"title\": \"Made to be copied\", \"description\": \"Small, commented files. Rename it, restyle it, and ship your own theme.\"}]"
                                    }
                                }
                            ]
