                                    }
                                },
                                {
                                    "id": "starter-blk-17",
                                    "block": "text",
                                    "settings": {},
                                    "data": {
                                        "body": "<p>This page shows how Starter styles long-form content: headings, rich text, a quote, a callout, a table and a team grid.</p><h2>Why a starter theme?</h2><p>A theme for Magna Pages is <strong>data</strong>: a manifest, a palette of tokens and a few Blade templates. Starter keeps each of those as small as it can be, so the shape of the contract is easy to see.</p><ul><li>One layout shell</li><li>Two example block overrides</li><li>A stylesheet built only from tokens</li></ul>"
                                    }
                                },
                                {
                                    "id": "starter-blk-18",
                                    "block": "quote",
                                    "settings": {},
                                    "data": {
                                        "quote": "Make it work, make it right, make it fast — in that order.",
                                        "attribution": "Kent Beck",
                                        "source": ""
                                    }
                                },
                                {
                                    "id": "starter-blk-19",
                                    "block": "callout",
                                    "settings": {},
                                    "data": {
                                        "heading": "Tip",
                                        "body": "Open this page in the builder and change any block. What you see in the canvas is exactly what ships.",
                                        "tone": "info"
                                    }
                                },
                                {
                                    "id": "starter-blk-20",
                                    "block": "table",
                                    "settings": {},
                                    "data": {
                                        "rows": "Token\tCSS variable\ncolors.primary\t--color-primary\nlayout.maxWidth\t--max-width\ntypography.fontBody\t--font-body",
                                        "separator": "tab",
                                        "header": "header",
                                        "rowHeader": "data",
                                        "footer": "data",
                                        "caption": "How tokens.json keys become CSS variables"
                                    }
                                }
                            ]
                        }
